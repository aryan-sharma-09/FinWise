# FinWise local database configuration.
#
# 1. Copy this file to `.env`:        cp .env.example .env
# 2. Fill in your MySQL password.     NEVER commit the real `.env` file.
#
# All values are read by python/db.py at runtime. Nothing here is secret
# except the password, which is why `.env` is gitignored.

FINWISE_DB_HOST=127.0.0.1
FINWISE_DB_PORT=3306

# Use your MySQL root account locally, or better: a dedicated least-privilege
# account created with the template in sql/00_create_database.sql.
FINWISE_DB_USER=root
FINWISE_DB_PASSWORD=

# Main demo database (created by sql/00_create_database.sql or the loader).
FINWISE_DB_NAME=finwise

# Separate database used by the automated test suite. It is dropped and
# recreated on every test run, so the name must contain the word "test".
FINWISE_TEST_DB_NAME=finwise_test

# --- MongoDB module (Person 3) -------------------------------------------
# The MongoDB collections are filled from MySQL by etl/load_mongo.py. MySQL
# stays the single source of truth; nothing is ever written back to it.
FINWISE_MONGO_URI=mongodb://127.0.0.1:27017

# Main MongoDB database (filled by etl/load_mongo.py).
FINWISE_MONGO_DB=finwise_mongo

# Disposable database used by the MongoDB tests. The name must contain the
# word "test"; it is dropped and rebuilt on every test run.
FINWISE_MONGO_TEST_DB=finwise_test_mongo
