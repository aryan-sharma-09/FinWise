# Normalize line endings to LF in the repository so macOS and Windows
# teammates get identical, diff-clean files on checkout.
* text=auto
*.sql text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.mmd text eol=lf
*.example text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.pdf binary
